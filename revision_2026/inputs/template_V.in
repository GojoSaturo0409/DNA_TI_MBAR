&cntrl
  imin=0,
  ntx=5,
  irest=1,

  nstlim=@NSTLIM@,
  dt=0.001,

  ntb=2,
  pres0=1.0,
  ntp=1,
  taup=2.0,

  tempi=300.0,
  temp0=300.0,
  ntt=3,
  gamma_ln=2.0,

  ntc=1,
  ntf=1,

  cut=10.0,

  ntpr=1000,
  ntwx=@NTWX@,
  ntwr=50000,

  ! --- TI core ---
  icfe=1,
  clambda=@LAM@,
  ifsc=1,

  ! --- Softcore masks ---
  timask1='@MASK@',
  scmask1='@MASK@',
  timask2='',
  scmask2='',

  ! --- Lambda scheduling (pmemd.cuda GTI) ---
  gti_lam_sch=1,
  gti_ele_sc=0,
  gti_vdw_sc=1,
  gti_cut_sc=2,

  ! --- Softcore corrections ---
  gti_add_sc=1,
  scalpha=0.2, scbeta=0.0,

  ! --- dvdl logging ---
  logdvdl=1,

  ifmbar=0,
/
